+// Create a thread that shares the caller's page table and has an independent
+// kernel stack. stack is the page-aligned base of a writable user stack page;
+// the user wrapper supplies a return trampoline as the fourth syscall word.
+int
+clone(void (*fcn)(void*), void *arg, void *stack, void (*ret)(void))
+{
+  int i, pid;
+  uint top, sp, value;
+  struct proc *np;
+  struct proc *curproc = myproc();
+
+  if(fcn == 0 || ret == 0 || stack == 0)
+    return -1;
+  if(((uint)stack % PGSIZE) != 0 || (uint)stack + PGSIZE < (uint)stack ||
+     (uint)stack + PGSIZE > curproc->sz)
+    return -1;
+  if(uva2ka(curproc->pgdir, (char*)fcn) == 0 ||
+     uva2ka(curproc->pgdir, (char*)ret) == 0 ||
+     uva2ka(curproc->pgdir, (char*)stack) == 0 ||
+     uva2ka(curproc->pgdir, (char*)((uint)stack + PGSIZE - 1)) == 0)
+    return -1;
+  if(arg && uva2ka(curproc->pgdir, (char*)arg) == 0)
+    return -1;
+
+  if((np = allocproc()) == 0)
+    return -1;
+
+  np->pgdir = curproc->pgdir;
+  np->sz = curproc->sz;
+  np->parent = curproc;
+  np->is_thread = 1;
+  np->group_leader = curproc->group_leader;
+  *np->tf = *curproc->tf;
+  np->tf->eip = (uint)fcn;
+  np->tf->eax = 0;
+
+  // A normal cdecl entry sees [return address, arg] at its initial ESP.
+  top = (uint)stack + PGSIZE;
+  sp = top - sizeof(uint);
+  value = (uint)arg;
+  if(copyout(np->pgdir, sp, &value, sizeof(value)) < 0)
+    goto badclone;
+  sp -= sizeof(uint);
+  value = (uint)ret;
+  if(copyout(np->pgdir, sp, &value, sizeof(value)) < 0)
+    goto badclone;
+  np->tf->esp = sp;
+
+  for(i = 0; i < NOFILE; i++)
+    if(curproc->ofile[i])
+      np->ofile[i] = filedup(curproc->ofile[i]);
+  np->cwd = idup(curproc->cwd);
+  safestrcpy(np->name, curproc->name, sizeof(np->name));
+  pid = np->pid;
+
+  acquire(&ptable.lock);
+  np->group_leader->group_threads++;
+  np->state = RUNNABLE;
+  release(&ptable.lock);
+  return pid;
+
+badclone:
+  acquire(&ptable.lock);
+  freeproc(np);
+  release(&ptable.lock);
+  return -1;
+}
