+int
+sys_clone(void)
+{
+  int fcn, arg, stack, ret;
+
+  if(argint(0, &fcn) < 0 || argint(1, &arg) < 0 ||
+     argint(2, &stack) < 0 || argint(3, &ret) < 0)
+    return -1;
+  return clone((void (*)(void*))fcn, (void*)arg, (void*)stack,
+               (void (*)(void))ret);
+}
