+
+// Called once per clock tick by CPU 0. A runnable process waiting for more
+// than 30 ticks gains one priority level, which prevents starvation.
+void
+schedtick(void)
+{
+  struct proc *p;
+  struct ageevent {
+    int pid;
+    int waited;
+    int old;
+    int new;
+  } aged[NPROC];
+  int i, n;
+
+  n = 0;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != RUNNABLE){
+      p->wait_ticks = 0;
+      continue;
+    }
+    p->wait_ticks++;
+    if(p->wait_ticks > 30){
+      aged[n].pid = p->pid;
+      aged[n].waited = p->wait_ticks;
+      aged[n].old = p->priority;
+      if(p->priority > 1)
+        p->priority--;
+      aged[n].new = p->priority;
+      n++;
+      p->wait_ticks = 0;
+    }
+  }
+  release(&ptable.lock);
+
+  for(i = 0; i < n; i++)
+    if(aged[i].old != aged[i].new)
+      cprintf("aging: pid %d waited %d ticks; priority %d->%d\n",
+              aged[i].pid, aged[i].waited, aged[i].old, aged[i].new);
+}
+
+int
+setpriority(int pid, int priority)
+{
+  struct proc *p;
+
+  if(priority < 1 || priority > 20)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++){
+    if(p->state != UNUSED && p->pid == pid){
+      p->priority = priority;
+      p->wait_ticks = 0;
       release(&ptable.lock);
       return 0;
     }
@@ -665,6 +751,37 @@ kill(int pid)
   return -1;
 }
 
+int
+getpriority(int pid)
+{
+  struct proc *p;
+  int priority;
+
+  priority = -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++)
+    if(p->state != UNUSED && p->pid == pid){
+      priority = p->priority;
+      break;
+    }
+  release(&ptable.lock);
+  return priority;
+}
+
+// Operations that replace or resize a page table are safe only when called
+// by the address-space leader with no live clone() threads.
+int
+group_is_single(void)
+{
+  struct proc *p = myproc();
+  int single;
+
+  acquire(&ptable.lock);
+  single = !p->is_thread && p->group_leader == p && p->group_threads == 0;
+  release(&ptable.lock);
+  return single;
+}
