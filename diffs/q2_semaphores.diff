diff --git a/semaphore.c b/semaphore.c
new file mode 100644
index 0000000..0be9ea4
--- /dev/null
+++ b/semaphore.c
@@ -0,0 +1,104 @@
+#include "types.h"
+#include "defs.h"
+#include "param.h"
+#include "memlayout.h"
+#include "mmu.h"
+#include "x86.h"
+#include "proc.h"
+#include "spinlock.h"
+#include "semaphore.h"
+
+static struct {
+  struct spinlock lock;
+  struct semaphore table[NSEMAPHORES];
+} sems;
+
+void
+seminit(void)
+{
+  int i;
+
+  initlock(&sems.lock, "semaphore table");
+  for(i = 0; i < NSEMAPHORES; i++){
+    sems.table[i].value = 0;
+    sems.table[i].initialized = 0;
+    sems.table[i].waiters = 0;
+    initlock(&sems.table[i].lk, "semaphore");
+  }
+}
+
+int
+sem_init_kernel(int id, int value)
+{
+  struct semaphore *s;
+
+  if(id < 0 || id >= NSEMAPHORES || value < 0)
+    return -1;
+  acquire(&sems.lock);
+  s = &sems.table[id];
+  acquire(&s->lk);
+  if(s->waiters != 0){
+    release(&s->lk);
+    release(&sems.lock);
+    return -1;
+  }
+  s->value = value;
+  s->initialized = 1;
+  release(&s->lk);
+  release(&sems.lock);
+  return 0;
+}
+
+int
+sem_wait_kernel(int id)
+{
+  struct semaphore *s;
+
+  if(id < 0 || id >= NSEMAPHORES)
+    return -1;
+  acquire(&sems.lock);
+  s = &sems.table[id];
+  if(!s->initialized){
+    release(&sems.lock);
+    return -1;
+  }
+  acquire(&s->lk);
+  release(&sems.lock);
+
+  s->value--;
+  if(s->value < 0){
+    s->waiters++;
+    sleep(s, &s->lk);         // signal() transfers one permit to this waiter
+    s->waiters--;
+    if(myproc()->killed){
+      s->value++;              // undo this wait if kill() was the wakeup
+      release(&s->lk);
+      return -1;
+    }
+  }
+  release(&s->lk);
+  return 0;
+}
+
+int
+sem_signal_kernel(int id)
+{
+  struct semaphore *s;
+
+  if(id < 0 || id >= NSEMAPHORES)
+    return -1;
+  acquire(&sems.lock);
+  s = &sems.table[id];
+  if(!s->initialized){
+    release(&sems.lock);
+    return -1;
+  }
+  acquire(&s->lk);
+  release(&sems.lock);
+
+  s->value++;
+  if(s->value <= 0)
+    wakeup(s);
+  release(&s->lk);
+  return 0;
+}
